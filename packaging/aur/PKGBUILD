# Maintainer: Iago Passos <iago.dpassos@gmail.com>
pkgname=libremerge
pkgver=1.0.1
pkgrel=1
pkgdesc="Diff and merge tool for files, folders and CSV tables - a Qt port of the WinMerge engine"
arch=('x86_64' 'aarch64')
url="https://github.com/iagodpassos/libremerge"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-wayland' 'qt6-imageformats' 'poco' 'icu' 'libarchive' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'boost' 're2c' 'lemon')
checkdepends=('gtest')
# the Tree-sitter grammars, at the commits engine/TreeSitterGrammars.cmake
# pins: CMake takes their archives from $srcdir (LM_TREE_SITTER_DOWNLOAD_DIR)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "tree-sitter-markdown-f969cd3ae3f9fbd4e43205431d0ae286014c05b5.tar.gz::https://github.com/tree-sitter-grammars/tree-sitter-markdown/archive/f969cd3ae3f9fbd4e43205431d0ae286014c05b5.tar.gz"
        "tree-sitter-properties-579b62f5ad8d96c2bb331f07d1408c92767531d9.tar.gz::https://github.com/tree-sitter-grammars/tree-sitter-properties/archive/579b62f5ad8d96c2bb331f07d1408c92767531d9.tar.gz"
        "tree-sitter-toml-64b56832c2cffe41758f28e05c756a3a98d16f41.tar.gz::https://github.com/tree-sitter-grammars/tree-sitter-toml/archive/64b56832c2cffe41758f28e05c756a3a98d16f41.tar.gz"
        "tree-sitter-yaml-7708026449bed86239b1cd5bce6e3c34dbca6415.tar.gz::https://github.com/tree-sitter-grammars/tree-sitter-yaml/archive/7708026449bed86239b1cd5bce6e3c34dbca6415.tar.gz"
        "tree-sitter-javascript-44c892e0be055ac465d5eeddae6d3e194424e7de.tar.gz::https://github.com/tree-sitter/tree-sitter-javascript/archive/44c892e0be055ac465d5eeddae6d3e194424e7de.tar.gz"
        "tree-sitter-typescript-f975a621f4e7f532fe322e13c4f79495e0a7b2e7.tar.gz::https://github.com/tree-sitter/tree-sitter-typescript/archive/f975a621f4e7f532fe322e13c4f79495e0a7b2e7.tar.gz")
noextract=('tree-sitter-markdown-f969cd3ae3f9fbd4e43205431d0ae286014c05b5.tar.gz'
           'tree-sitter-properties-579b62f5ad8d96c2bb331f07d1408c92767531d9.tar.gz'
           'tree-sitter-toml-64b56832c2cffe41758f28e05c756a3a98d16f41.tar.gz'
           'tree-sitter-yaml-7708026449bed86239b1cd5bce6e3c34dbca6415.tar.gz'
           'tree-sitter-javascript-44c892e0be055ac465d5eeddae6d3e194424e7de.tar.gz'
           'tree-sitter-typescript-f975a621f4e7f532fe322e13c4f79495e0a7b2e7.tar.gz')
sha256sums=('87445adff9e86d1e4bda2ea43209d74342849889a96020c03c52de0f081b8e49'
            '45ec28324b75ec80788775a6aed26888f55b306981fede9cbe35d7348ae80469'
            '97399c48a90c2b6809870e14f34d2ac0bcd8842a1b4c2031d5be242170d4d2e0'
            'feeb2e1cf531588cdcfb9c57292620151a08597f18a98dad26cc17fd4b544dcb'
