# Maintainer: Iago Passos <iago.dpassos@gmail.com>
pkgname=libremerge
pkgver=0.9.8
pkgrel=1
pkgdesc="Diff and merge tool for files, folders and CSV tables - a Qt port of the WinMerge engine"
arch=('x86_64' 'aarch64')
url="https://github.com/iagodpassos/libremerge"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-wayland' 'qt6-imageformats' 'poco' 'icu' 'libarchive' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'boost' 're2c' 'lemon')
checkdepends=('gtest')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('344852f6c04357e40b3907e41b4a37e1b5a1637f6025e26084b467d6e76c5d93')

build() {
  cd "$pkgname-$pkgver"
  cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd "$pkgname-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
