# Maintainer: Iago Passos <iago.dpassos@gmail.com>
# What is on the main branch before it is released, for trying a change
# early; ../aur/PKGBUILD packages the latest release.
pkgname=libremerge-git
_pkgname=libremerge
pkgver=1.5.0.r20.gba0db92
pkgrel=1
pkgdesc="Diff and merge tool for files, folders and CSV tables - a Qt port of the WinMerge engine (main branch)"
arch=('x86_64' 'aarch64')
url="https://github.com/iagodpassos/libremerge"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-wayland' 'qt6-imageformats' 'poco' 'icu' 'libarchive' 'hicolor-icon-theme')
makedepends=('git' 'cmake' 'ninja' 'boost' 're2c' 'lemon')
checkdepends=('gtest')
provides=("$_pkgname")
conflicts=("$_pkgname")
# the Tree-sitter grammars are downloaded as CMake configures, at the
# commits engine/TreeSitterGrammars.cmake pins on the branch
source=("$_pkgname::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$_pkgname"
  cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd "$_pkgname"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "$_pkgname"
  DESTDIR="$pkgdir" cmake --install build
}
